---
import type { MarkdownHeading } from "astro";

type TocItem = MarkdownHeading | TocItem[];

const { items, depth, minDepth, maxDepth } = Astro.props;

export interface Props {
  items: TocItem[];
  depth: number;
  minDepth: number;
  maxDepth?: number | undefined;
}
---

{
  maxDepth !== undefined && depth > maxDepth ? undefined : (
    <ul class="flex flex-col">
      {items.map(item => (
        <>
          {Array.isArray(item) ? (
            <li>
              <Astro.self
                items={item}
                depth={depth + 1}
                minDepth={minDepth}
                maxDepth={maxDepth}
              />
            </li>
          ) : (
            <li
              id={`toc-${item.slug}`}
              class={`py-2 border-l border-border toc-indent-${depth - minDepth}`}
            >
              <a class="hover:text-accent" href={`#${item.slug}`}>
                {item.text}
              </a>
            </li>
          )}
        </>
      ))}
    </ul>
  )
}
