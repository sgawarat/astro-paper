---
import dayjs from "dayjs";
import utc from "dayjs/plugin/utc";
import timezone from "dayjs/plugin/timezone";
import IconCalendar from "@/assets/icons/IconCalendar.svg";
import config from "@/config";
import { useTranslations } from "@/i18n";

dayjs.extend(utc);
dayjs.extend(timezone);

type Props = {
  class?: string;
  size?: "sm" | "lg";
  pubDatetime: string | Date;
  timezone?: string;
  modDatetime?: string | Date | null;
};

const {
  pubDatetime,
  modDatetime,
  size = "sm",
  class: className = "",
  timezone: postTimezone,
} = Astro.props;

const t = useTranslations(Astro.currentLocale);

/*
const isModified = modDatetime && modDatetime > pubDatetime;

const datetime = dayjs(isModified ? modDatetime : pubDatetime).tz(
  postTimezone ?? config.site.timezone
);

const date = datetime.format("D MMM, YYYY");
*/

const modDatetimeLocal = dayjs(modDatetime).tz(postTimezone || config.site.timezone);
const pubDatetimeLocal = dayjs(pubDatetime).tz(postTimezone || config.site.timezone);

// 日を跨いでの作業が修正に含まれないようにするため、判定に1日の猶予を持たせる
const isModified =
  modDatetimeLocal && modDatetimeLocal > pubDatetimeLocal.add(1, "day");

const modDate = modDatetimeLocal.format("YYYY-MM-DD");
const pubDate = pubDatetimeLocal.format("YYYY-MM-DD");
---

<div
  class:list={["text-muted-foreground flex items-center gap-x-2", className]}
>
  <IconCalendar
    class:list={[
      "inline-block size-6 min-w-5.5",
      { "scale-90": size === "sm" },
    ]}
  />
<!--
  {
    isModified && (
      <span class:list={["text-sm", { "sm:text-base": size === "lg" }]}>
        {t.post.updatedAt}:
      </span>
    )
  }
  <time
    class:list={["text-sm", { "sm:text-base": size === "lg" }]}
    datetime={datetime.toISOString()}
  >
    {date}
  </time>
-->

  <time
    class:list={["text-sm", { "sm:text-base": size === "lg" }]}
    datetime={pubDatetimeLocal.toISOString()}>{pubDate}</time
  >
  {
    isModified && (
      <>
        <span class:list={["text-sm", { "sm:text-base": size === "lg" }]}>
          ·
        </span>
        <span class:list={["text-sm", { "sm:text-base": size === "lg" }]}>
          {t.post.updatedAt}:
          <time
            class:list={["text-sm", { "sm:text-base": size === "lg" }]}
            datetime={modDatetimeLocal.toISOString()}
          >
            {modDate}
          </time>
        </span>
      </>
    )
  }
</div>
